uint8_t state = 0;//定义状态
uint16_t duty_p1 = 50;//从百分之五开始
uint16_t duty_p2 = 950;
uint32_t last_key_tick = 0;
/* USER CODE END 0 */

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_TIM1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  HAL_TIM_PWM_Start(&htim1 ,  TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim2 ,  TIM_CHANNEL_2);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */


/* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == GPIO_PIN_RESET)
    { 
      HAL_Delay(50);//机械按键延迟消抖
 
      if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == GPIO_PIN_RESET)//按下之后的设置状态
      {
        state = (state + 1) % 6 ;//最后一下实现循环
 
        if (state == 1)//给每个状态进行pwm的初始值设置
        {
          duty_p1 = 50; duty_p2 = 95;
        }
        if (state == 2)
        {
          duty_p1 = 50; duty_p2 = 95;
        }
        if (state == 3)
        {
          duty_p1 = 950; duty_p2 = 0;
        }
        while (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_2) == GPIO_PIN_RESET);//等待按键松开，避免按一下就跳过好多状态

      }
    }

  


    if (state == 0)
    {
      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
      __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 0);//让pwm输出口保持低电平

      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4 , GPIO_PIN_SET );//让led的输出保持高电平，全灭（再也不用杂七杂八的口了！）


    }

    else if (state == 1)
    {
      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 50);
      __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 95);//更新寄存器
    }

    else if (state == 2)//p1从5到95，p2从95到5，步长为5，注意频率不同！！
    {
      static uint32_t last_tick = 0;//控制呼吸速度
      if (HAL_GetTick() - last_tick > 200)//每200ms更新一次占空比
      {
        last_tick = HAL_GetTick();//时间戳更新
        duty_p1 += 50;
        duty_p2 -= 5;

      if (duty_p1 > 950) 
        duty_p1 = 50;
      if (duty_p2 < 0) 
        duty_p2 = 95;//到达临界后的情况

      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty_p1);
      __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, duty_p2);//寄存器的数据更新
      }
    }


    else if (state == 3)//p1递减，p2递增
    {
      static uint32_t last_tick = 0;
      if (HAL_GetTick() - last_tick > 200)//同上
      {
        last_tick = HAL_GetTick();
      duty_p1 -= 50;//对应占空比自减
      duty_p2 += 5;

      if (duty_p1 < 50) 
        duty_p1 = 950;
      if (duty_p2 > 95) 
         duty_p2 = 0;//到达临界后的情况

      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty_p1);
      __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, duty_p2);//寄存器的数据更新

      }
    }


    if (state == 4)
    {
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5, GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12 , GPIO_PIN_RESET);
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3 , GPIO_PIN_SET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4 , GPIO_PIN_SET );//本来可以尝试一下寄存器      
    }


    else if (state == 5)
    {
      __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 999);
      __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_2, 999);//输出高电平

      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_5 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_9 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_10 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_12 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOA, GPIO_PIN_15 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_3 , GPIO_PIN_RESET );
      HAL_GPIO_WritePin(GPIOB, GPIO_PIN_4 , GPIO_PIN_RESET );//全亮
    }
  }
}

  

 

